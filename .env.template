# =====================================================================
# Dify 系统配置 - .env 模板文件
# =====================================================================
# 
# 使用说明：
# 1. 将此文件复制为 .env
# 2. 根据实际环境修改各个配置项
# 3. 确保所有密码使用强密码（16+字符，包含大小写和特殊符号）
# 4. 不将.env文件提交到版本控制
#
# =====================================================================

# ===== 基础配置 =====
# 应用运行模式（production或development）
MODE=production

# 调试模式（开发时设为true，生产环境必须设为false）
DEBUG=false

# Django密钥（用于安全加密）必填项！使用强随机字符串
SECRET_KEY=change-me-to-a-strong-random-secret-key-min-32-chars

# 应用时区
TIME_ZONE=Asia/Shanghai

# ===== 数据库配置 =====
# PostgreSQL 基础配置
POSTGRES_PASSWORD=change-me-strong-postgres-password-16chars-plus

# 如果使用远程数据库，可选配置下列变量
# DB_HOST=remote-db-host
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your-remote-db-password
# DB_DATABASE=dify

# ===== Redis 缓存配置 =====
# Redis 密码（使用强密码）
REDIS_PASSWORD=change-me-strong-redis-password-16chars-plus

# 如果使用远程Redis，可选配置
# REDIS_URL=redis://:password@remote-host:6379/0

# ===== 向量数据库配置 (Weaviate) =====
# Weaviate API密钥
WEAVIATE_API_KEY=change-me-strong-weaviate-api-key-16chars

# Weaviate 端点（本地部署）
WEAVIATE_ENDPOINT=http://weaviate:8080

# 是否启用Weaviate向量数据库
WEAVIATE_ENABLED=true

# ===== 嵌入模型配置 =====
# 使用的嵌入模型（用于将文本转换为向量）
# 推荐：BGE-large-zh-v1.5（中文优化）
EMBEDDING_MODEL_NAME=BGE-large-zh-v1.5

# 嵌入模型提供商
EMBEDDING_MODEL_PROVIDER=huggingface

# 嵌入模型所在路径
EMBEDDING_MODEL_PATH=/models/

# 嵌入向量维度（BGE-large-zh-v1.5为1024）
EMBEDDING_MODEL_DIMENSION=1024

# ===== 大语言模型 (LLM) 配置 =====

# --- DeepSeek API ---
# DeepSeek API密钥（必填！从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=change-me-to-your-deepseek-api-key

# DeepSeek API端点（可选，默认官方端点）
DEEPSEEK_API_URL=https://api.deepseek.com

# DeepSeek 模型版本（选项: deepseek-chat, deepseek-v3等）
DEEPSEEK_MODEL=deepseek-v3

# --- OpenAI/Claude API （可选备选方案）---
# OpenAI API密钥（可选，如要使用OpenAI）
OPENAI_API_KEY=change-me-to-your-openai-api-key-if-needed

# Claude API密钥（可选）
# ANTHROPIC_API_KEY=your-anthropic-key-if-needed

# ===== 文件上传配置 =====
# 文件上传基础路径
FILES_UPLOAD_BASE_PATH=/data/storage

# 最大文件上传大小 (字节)
# 默认 100MB
MAX_FILE_SIZE=104857600

# ===== Web UI 配置 =====
# 前端API地址
NEXT_PUBLIC_API_URL=http://dify-api:5001

# 前端应用地址
NEXT_PUBLIC_APP_URL=http://localhost/studio

# 控制台地址
CONSOLE_WEB_URL=http://localhost/console

# ===== 可选：知识库/RAG配置 =====
# 默认知识库类型（weaviate）
DEFAULT_KNOWLEDGE_BASE_TYPE=weaviate

# 混合检索权重配置
# BM25权重（关键词匹配）
HYBRID_SEARCH_BM25_WEIGHT=0.3

# 向量权重（语义相似度）
HYBRID_SEARCH_VECTOR_WEIGHT=0.7

# 检索Top K（返回前K条结果）
KNOWLEDGE_BASE_TOP_K=5

# 相似度阈值（0-1，过滤低相似度结果）
KNOWLEDGE_BASE_SIMILARITY_THRESHOLD=0.5

# ===== 可选：日志配置 =====
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志输出路径
LOG_FILE_PATH=/data/dify/logs/dify.log

# ===== 可选：邮件通知配置 =====
# SMTP服务器
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ===== 可选：HTTPS/SSL配置 =====
# 仅在生产环境使用HTTPS时配置
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem

# =====================================================================
# 重要安全提示
# =====================================================================
#
# 1. 密码要求：
#    - 最少16个字符
#    - 包含大小字母、数字和特殊符号
#    - 不要使用简单的密码或字典词汇
#
# 2. API密钥：
#    - DeepSeek/OpenAI密钥需从官方平台申请
#    - 不要将密钥提交到版本控制
#    - 定期轮换密钥
#
# 3. 生产环境：
#    - 设置 DEBUG=false
#    - 使用强SECRET_KEY
#    - 配置HTTPS
#    - 定期备份数据库
#    - 监控系统日志
#
# =====================================================================
